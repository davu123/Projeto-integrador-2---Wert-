# Produção. Na VPS, copie para src/deploy/.env e preencha. O .env não vai para o repositório.
# Não use $, aspas nem espaços nos valores.

# Subdomínio que aponta para a VPS pelo registro A, sem https://.
DOMAIN=ecotrack.exemplo.com.br

# Senha do usuário sa do SQL Server: no mínimo 8 caracteres, com maiúsculas, minúsculas, números e símbolo.
DB_PASSWORD=
DB_DATABASE=EcoTrackWert

# Segredo dos tokens de login. Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Primeiro administrador. Só é criado quando o banco não tem nenhum administrador.
# Depois do primeiro acesso e da troca de senha, apague o ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=
