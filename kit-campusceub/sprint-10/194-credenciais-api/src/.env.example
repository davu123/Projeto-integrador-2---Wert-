# Copie para src/.env antes do docker compose up. O .env não vai para o repositório.

# Segredo que assina os tokens de login. Sem ele a API não sobe.
# Gere um valor longo e aleatório, por exemplo: openssl rand -hex 32
JWT_SECRET=

# Primeiro administrador. Só é criado quando o banco não tem nenhum administrador.
# Senha com no mínimo 8 caracteres. Troque a senha em Minha conta no primeiro acesso.
ADMIN_EMAIL=admin@wert.com.br
ADMIN_PASSWORD=
